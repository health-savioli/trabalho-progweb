# Copie este arquivo para ".env" e preencha com os seus valores.
# O ".env" não vai para o GitHub.

# Banco de dados (MySQL 8 ou superior)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=progweb
DB_USERNAME=root
DB_PASSWORD=sua-senha-do-mysql

# Chave que assina os tokens de login (JWT). Use um texto aleatório com 32 ou mais caracteres.
# Exemplo para gerar um: openssl rand -hex 32
JWT_SECRET=troque-esta-chave-por-um-texto-aleatorio-com-32-caracteres

# Token da API de aferição (integrador). Sem ele, a aferição não funciona.
INTEGRADOR_TOKEN=

# Administrador criado automaticamente na primeira execução
ADMIN_EMAIL=admin@progweb.com
ADMIN_PASSWORD=admin123
